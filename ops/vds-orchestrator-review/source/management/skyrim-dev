#!/bin/sh
set -eu

PY=/srv/services/skyrim-dev/orchestrator/supervisor.py
UNIT=skyrim-dev-orchestrator.service
ENVV="HOME=/home/skyrimdev CODEX_HOME=/home/skyrimdev/.codex GH_CONFIG_DIR=/home/skyrimdev/.config/gh PATH=/usr/local/bin:/usr/bin:/bin"

usage() {
    printf '%s\n' 'usage: skyrim-dev {status|roadmap-status|milestone-status|sync-control-plane|start|pause|resume|stop|logs|healthcheck|self-test|worker-smoke-test|architect-review-smoke-test|review-status|approve|retry|block|approve-task|approve-control-plane|accept-milestone|re-review-v3} [argument]'
}

run_service() {
    if [ "$(id -u)" -eq 0 ]; then
        runuser -u skyrimdev -- env $ENVV /usr/bin/python3 "$PY" "$@"
    else
        env $ENVV /usr/bin/python3 "$PY" "$@"
    fi
}

# Mutating operator commands are submitted to the live daemon by supervisor.py;
# this wrapper never edits runtime state directly.

if [ "$#" -gt 0 ]; then
    command_name="$1"
else
    command_name=status
fi

case "$command_name" in
    status)
        run_service status
        ;;
    roadmap-status|milestone-status|sync-control-plane)
        run_service "$command_name"
        ;;
    start|resume)
        if [ "$(id -u)" -ne 0 ]; then
            printf '%s\n' 'start/resume requires root' >&2
            exit 1
        fi
        exec env $ENVV /usr/bin/python3 "$PY" control "$command_name"
        ;;
    pause)
        run_service control pause
        ;;
    stop)
        if [ "$(id -u)" -ne 0 ]; then
            printf '%s\n' 'stop requires root' >&2
            exit 1
        fi
        exec env $ENVV /usr/bin/python3 "$PY" control stop
        ;;
    logs)
        journalctl -u "$UNIT" -n 200 --no-pager
        printf '%s\n' '--- supervisor log ---'
        tail -n 200 /var/log/skyrim-dev/supervisor.log 2>/dev/null || true
        ;;
    healthcheck)
        run_service healthcheck
        ;;
    self-test)
        run_service self-test
        ;;
    worker-smoke-test)
        run_service worker-smoke-test
        ;;
    architect-review-smoke-test)
        run_service architect-review-smoke-test
        ;;
    review-status)
        run_service review-status
        ;;
    approve|retry|block)
        if [ "$#" -ne 2 ]; then
            usage >&2
            exit 2
        fi
        run_service "$command_name" "$2"
        ;;
    approve-task|approve-control-plane)
        if [ "$#" -ne 2 ]; then
            usage >&2
            exit 2
        fi
        run_service "$command_name" "$2"
        ;;
    re-review-v3)
        if [ "$#" -ne 17 ]; then
            usage >&2
            exit 2
        fi
        run_service "$@"
        ;;
    accept-milestone)
        if [ "$#" -lt 2 ] || [ "$#" -gt 4 ]; then
            usage >&2
            exit 2
        fi
        if [ "$#" -eq 4 ] && [ "$3" = "--evidence-file" ]; then
            run_service "$command_name" "$2" "$3" "$4"
        elif [ "$#" -eq 2 ]; then
            run_service "$command_name" "$2"
        else
            usage >&2
            exit 2
        fi
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
